# Environment variables for K.I.S.A.N. AI

# Official Indian Government Data API Key (data.gov.in)
# Register and obtain key from https://data.gov.in/
GOV_API_KEY=your_data_gov_in_api_key_here

# Twilio Voice & Messaging Configuration
# Obtain credentials from Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Public base URL (e.g., ngrok or production domain) for Twilio webhook callbacks
TWILIO_WEBHOOK_BASE_URL=https://your-domain.ngrok-free.app
